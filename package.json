{
  "name": "daily-news",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": { "node": ">=22.15.0" },
  "scripts": {
    "dev": "npm run build:client && npm run start",
    "dev:client": "vite",
    "build:client": "vite build",
    "build": "npm run typecheck && npm run build:client && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start:production": "node --env-file-if-exists=.env build/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check:feeds": "node --env-file-if-exists=.env --import tsx server/check-feeds.ts"
  },
  "dependencies": {
    "entities": "^6.0.1",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
